# Machine-specific settings for this repository.
#
# Copy this file to `config/local.env` and edit the values to match your
# workstation. `config/local.env` is git-ignored, so your local paths, robot IP
# and device serials never leave your machine.
#
#     cp config/local.env.example config/local.env
#     ${EDITOR:-nano} config/local.env
#
# Every wrapper script under scripts/ sources it automatically. Nothing here is
# required if the defaults already match your setup.

# --- Python environment -----------------------------------------------------

# Where your conda installation puts its shell hook. Run `conda info --base`
# and append /etc/profile.d/conda.sh to find yours.
GRIP_CONDA_SETUP="${HOME}/miniconda3/etc/profile.d/conda.sh"

# Name of the conda environment created by scripts/setup/create_env.sh.
GRIP_CONDA_ENV="act"

# Interpreter used for the two Tk operator GUIs. These need a Python that was
# built with tkinter; the system Python normally is, conda ones often are not.
GRIP_SYSTEM_PYTHON="/usr/bin/python3"

# --- ROS 2 ------------------------------------------------------------------

# ROS 2 Jazzy installation.
GRIP_ROS_SETUP="/opt/ros/jazzy/setup.bash"

# Optional. Some ROS nodes import h5py / pygame / yaml, which must be visible to
# the *system* Python that runs ROS, not to the conda environment. If you
# installed them somewhere outside the system dist-packages, point at that
# directory here. Leave empty if `python3 -c "import h5py, pygame, yaml"` already
# works with ROS sourced.
GRIP_ROS_PYDEPS=""

# ROS 2 middleware isolation. LOCALHOST keeps this workstation's ROS graph from
# reaching other machines on the LAN.
ROS_DOMAIN_ID="0"
ROS_AUTOMATIC_DISCOVERY_RANGE="LOCALHOST"

# --- Hardware ---------------------------------------------------------------

# IP address of the Indy7 controller (Neuromeka DCP3).
GRIP_INDY_IP="192.168.0.10"

# Serial number of the overhead Intel RealSense D435, with a leading underscore.
# Find it with: rs-enumerate-devices -s
GRIP_CAMERA_SERIAL="_000000000000"

# Serial port of the Mand.ro Mark7 hand. Prefer the stable by-id path over
# /dev/ttyACM0, which changes between reboots.
# Find it with: ls -l /dev/serial/by-id/
GRIP_MARK7_PORT="/dev/ttyACM0"

# Xbox controller event device, used only for manual teleoperation.
# Find it with: ls /dev/input/by-id/ | grep -i event-joystick
GRIP_XBOX_DEVICE="/dev/input/by-id/usb-Microsoft_Controller-event-joystick"

# --- Inference --------------------------------------------------------------

# ZMQ endpoint of the ACT policy server. Change the port if 5557 is taken.
GRIP_ACT_ENDPOINT="tcp://127.0.0.1:5557"
